{
  "name": "sunrise-frontend",
  "version": "1.0.0",
  "description": "Sunrise Coaching Khargone ERP (Angular + Capacitor + Electron)",
  "author": "Sunrise Coaching Khargone",
  "homepage": "https://github.com/priyanshu1906gupta/sunrise-frontend",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --ssl --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "build:native": "ng build --configuration native && npx cap sync && node scripts/patch-native-security.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "electron:start": "ng build --configuration native && electron electron/main.js",
    "electron:build": "ng build --configuration native && electron-builder",
    "publish:native": "node scripts/publish-native-builds.js"
  },
  "build": {
    "appId": "com.sunrisecoaching.khargone",
    "productName": "Sunrise Coaching Khargone",
    "files": [
      "electron/**/*",
      "dist/coreui-free-angular-admin-template/browser/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/aria": "^22.1.3",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/language-service": "^22.1.3",
    "@angular/localize": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@capacitor/android": "^8.5.2",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@coreui/angular": "~5.7.20",
    "@coreui/angular-chartjs": "~5.7.20",
    "@coreui/chartjs": "^4.2.0",
    "@coreui/coreui": "^5.9.0",
    "@coreui/icons": "^3.1.0",
    "@coreui/icons-angular": "~5.7.20",
    "@coreui/utils": "^2.0.2",
    "chart.js": "^4.5.1",
    "ngx-scrollbar": "^13.0.3",
    "pdfjs-dist": "^6.3.289",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.3",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "^4.1.11",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyanshu1906gupta/sunrise-frontend.git"
  }
}
